{
  "name": "@netlify/mcp",
  "version": "1.22.1",
  "description": "",
  "type": "module",
  "main": "./dist/netlify-mcp.js",
  "bin": {
    "netlify-mcp": "./dist/netlify-mcp.js"
  },
  "homepage": "https://docs.netlify.com/welcome/build-with-ai/netlify-mcp-server/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netlify/netlify-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/netlify/netlify-mcp/issues"
  },
  "scripts": {
    "build": "tsup ./netlify-mcp.ts --format esm",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --import ./scripts/register-ts-js-loader.mjs --test \"src/**/*.test.ts\" \"netlify/**/*.test.ts\"",
    "verify:coding-context": "node --import ./scripts/register-ts-js-loader.mjs scripts/verify-coding-context.mjs",
    "start": "node ./dist/netlify-mcp.js",
    "build:publish": "rm -rf ./dist && npm run build && npm publish"
  },
  "files": [
    "dist/*",
    "package.json"
  ],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.1",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@netlify/blobs": "^11.1.9",
    "@netlify/dev-utils": "^6.1.0",
    "@netlify/edge-functions": "^4.0.4",
    "@netlify/functions": "^6.1.1",
    "archiver": "^7.0.1",
    "fetch-to-node": "^2.1.0",
    "jose": "^6.0.11",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@netlify/open-api": "^2.63.1",
    "@types/node": "^22.15.32",
    "fflate": "0.8.2",
    "pkg-pr-new": "^0.0.88",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
